{
  "name": "mediacenter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mediacenter – Video, Audio und Bilder direkt im Browser konvertieren und komprimieren.",
  "scripts": {
    "predev": "node scripts/copy-ffmpeg-core.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ffmpeg-core.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "client-zip": "^2.4.6",
    "heic2any": "^0.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
