# Optional: URL der Server-Variante (Express + natives ffmpeg, siehe server/).
# Ist die Variable gesetzt, bietet die App fuer sehr grosse Dateien zusaetzlich
# die Verarbeitung ueber die API an. Ohne diese Variable laeuft alles rein lokal.
VITE_API_URL=

# Ab welcher Dateigroesse (MB) die Server-Variante vorgeschlagen wird.
VITE_API_THRESHOLD_MB=2048
